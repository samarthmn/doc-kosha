# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Enables the authenticated in-app Help widget (demo video library)
NEXT_PUBLIC_ENABLE_PRODUCT_GUIDES=false

# --- Document processing ----------------------------------------------------
# DocKosha uses the DocYantra provider. Its adapter, engine, office, and font
# packages are installed as normal production dependencies.
# Allowed values: local, staging, production
NEXT_PUBLIC_APP_ENV=local

# Runtime / CI
# CI=1

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role (server-only)
SUPABASE_SERVICE_ROLE_KEY=

# Transactional Email (SMTP: ZeptoMail in staging/prod, Supabase Mailpit locally) (For important emails like OTP, NDA signing, etc.)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=noreply@dockosha.com
NOTIFICATION_SENDER_EMAIL=notifications@dockosha.com
FOUNDER_SENDER_EMAIL=samarth@dockosha.com
LIFECYCLE_PROCESSOR_SECRET=
# Local-only lifecycle timing overrides for fast Mailpit testing
LIFECYCLE_DELAY_SETUP_INCOMPLETE_1H_MS=
LIFECYCLE_DELAY_SETUP_INCOMPLETE_2D_MS=
LIFECYCLE_DELAY_FOUNDER_HELP_DAY_1_MS=
LIFECYCLE_DELAY_TRIAL_ENDING_OFFSET_MS=
LIFECYCLE_INACTIVITY_THRESHOLD_MS=
LIFECYCLE_RECENT_NUDGE_WINDOW_MS=

# Cookie secret for signed HTTPOnly cookies (OTP verification)
COOKIE_SECRET=
# Dedicated secret for comment author identity hashing (min 32 chars)
COMMENTS_AUTHOR_SECRET=

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Analytics (Optional, Consent-Gated)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Ads tag (Optional, Consent-Gated on marketing pages)
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-xxxxxxxxxx

# LinkedIn Insight (Optional, Consent-Gated on marketing pages)
# NEXT_PUBLIC_LINKEDIN_PARTNER_ID=xxxxxxxxxx

# Apollo website tracker (Optional, Consent-Gated on marketing pages)
# NEXT_PUBLIC_APOLLO_TRACKER_APP_ID=xxxxxxxxxxxxxxxxxxx

# Meta Pixel (Optional, Consent-Gated on marketing pages)
# NEXT_PUBLIC_META_PIXEL_ID=xxxxxxxxxxxxxxxx

# PostHog (Consent-gated analytics and feature flags, production-only runtime gate)
# Default host: https://s.dockosha.com (managed proxy). Use /ingest if you need to route through Next.js rewrites (see next.config.ts).
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://s.dockosha.com

# Sentry (Optional, production-only runtime gate)
# Browser error reporting requires the public DSN; server error reporting uses
# the server-only DSN. Leave both unset to keep Sentry inert.
# NEXT_PUBLIC_SENTRY_DSN=https://public@example.ingest.sentry.io/project-id
SENTRY_DSN=

# Stripe
# Allowed values: local, staging, production, test, live
STRIPE_MODE=local
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Sentry authentication token
SENTRY_AUTH_TOKEN=

# Testing environment variables
# Playwright / E2E (tests/e2e)
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Mailpit URL for OTP email retrieval in E2E tests
MAILPIT_BASE_URL=http://localhost:54324

R2_ENDPOINT=http://localhost:9000
R2_REGION=us-east-1
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=dockosha

# Cloudflare Custom Hostnames (optional; custom-domain operations require all four)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# CNAME target that customers must point their domain to (e.g., custom.dockosha.com)
CLOUDFLARE_CUSTOM_HOSTNAME_FALLBACK_ORIGIN=
# Shared secret forwarded by the Cloudflare Worker to authenticate forwarded host/country headers (minimum 32 characters)
# Configure the same value as a Wrangler secret and never commit it.
CLOUDFLARE_WORKER_ORIGIN_SECRET=
