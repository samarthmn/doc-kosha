{
  "name": "doc-kosha",
  "version": "1.0.0",
  "description": "AGPL-licensed document sharing and virtual data rooms with server-enforced gates, watermarking, analytics, and audit trails.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samarthmn/doc-kosha.git"
  },
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev",
    "dev:turbopack": "node scripts/prepare-engine-assets.mjs && node scripts/sync-pdfjs-assets.mjs && next dev --turbopack",
    "dev:backend:up": "concurrently -n supabase,r2 -c blue,cyan \"pnpm supabase:up\" \"pnpm r2:up\"",
    "dev:backend:logs": "concurrently -n supabase,r2 -c blue,cyan \"pnpm supabase:logs\" \"pnpm r2:logs\"",
    "dev:backend:watch": "concurrently -n logs,stripe -c gray,yellow \"pnpm dev:backend:logs\" \"pnpm stripe:webhook\"",
    "dev:backend:reset": "sh scripts/reset-local-stack.sh",
    "dev:backend:down": "concurrently -n supabase,r2 -c blue,cyan \"pnpm supabase:down\" \"pnpm r2:down\"",
    "dev:staging": "node scripts/prepare-engine-assets.mjs && node scripts/sync-pdfjs-assets.mjs && env-cmd -f .env.staging next dev",
    "dev:staging:turbopack": "node scripts/prepare-engine-assets.mjs && node scripts/sync-pdfjs-assets.mjs && env-cmd -f .env.staging next dev --turbopack",
    "dev:production": "node scripts/prepare-engine-assets.mjs && node scripts/sync-pdfjs-assets.mjs && env-cmd -f .env.production next dev",
    "dev:production:turbopack": "node scripts/prepare-engine-assets.mjs && node scripts/sync-pdfjs-assets.mjs && env-cmd -f .env.production next dev --turbopack",
    "predev": "node scripts/prepare-engine-assets.mjs && node scripts/sync-pdfjs-assets.mjs",
    "prebuild": "node scripts/prepare-engine-assets.mjs && node scripts/sync-pdfjs-assets.mjs",
    "build": "next build --webpack",
    "build:staging": "node scripts/prepare-engine-assets.mjs && node scripts/sync-pdfjs-assets.mjs && env-cmd -f .env.staging next build --webpack",
    "build:production": "node scripts/prepare-engine-assets.mjs && node scripts/sync-pdfjs-assets.mjs && env-cmd -f .env.production next build --webpack",
    "start": "next start",
    "prepare": "husky",
    "audit:manifest": "node scripts/check-public-manifest.mjs --mode=check",
    "export:public": "node scripts/export-public-release.mjs",
    "audit:licenses": "node scripts/check-licenses.mjs",
    "audit:release-references": "node scripts/check-release-references.mjs",
    "audit:secrets": "node scripts/run-gitleaks.mjs",
    "test:audit-tools": "node --test scripts/audit-tools.test.mjs scripts/license-audit.test.mjs scripts/release-references.test.mjs",
    "lint": "eslint src tests scripts",
    "lint:fix": "eslint --fix src tests scripts",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "format:policies": "node scripts/format-policies.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "generate:types": "supabase gen types typescript --local --schema public,storage,auth > src/types/generated/supabase.ts",
    "test:unit": "node --import tsx --test \"tests/unit/*.test.ts\"",
    "test:engine": "node scripts/run-engine-unit-tests.mjs",
    "e2e": "pnpm test:unit && playwright test --grep-invert @engine",
    "e2e:engine": "playwright test --grep @engine",
    "e2e:headed": "playwright test --headed",
    "e2e:core": "playwright test --grep @core",
    "e2e:cloud": "playwright test --grep @cloud",
    "email:preview": "tsx scripts/email/render-previews.ts",
    "email:check": "tsx scripts/email/smoke-check.ts",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files --format",
    "supabase:up": "supabase start",
    "supabase:down": "supabase stop",
    "supabase:logs": "tsx scripts/supabase-local-logs.ts",
    "r2:up": "docker compose -f docker-compose.r2.yml up -d",
    "r2:down": "docker compose -f docker-compose.r2.yml down",
    "r2:logs": "docker compose -f docker-compose.r2.yml logs -f minio",
    "stripe:webhook": "stripe listen --forward-to localhost:3000/stripe/webhook/v1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.972.0",
    "@aws-sdk/s3-request-presigner": "^3.972.0",
    "@hookform/resolvers": "^5.2.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.6",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-context-menu": "^2.2.7",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.1.5",
    "@radix-ui/react-tabs": "^1.1.7",
    "@samarthmn/dockosha-provider-docyantra": "0.0.25",
    "@samarthmn/doc-yantra-fonts": "0.0.25",
    "@sentry/nextjs": "^10",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.56.0",
    "@tiptap/extension-underline": "^3.14.0",
    "@tiptap/pm": "^3.14.0",
    "@tiptap/react": "^3.14.0",
    "@tiptap/starter-kit": "^3.14.0",
    "@xmldom/xmldom": "^0.8.15",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookies-next": "^6.1.1",
    "date-fns": "^3.6.0",
    "fflate": "^0.8.2",
    "gray-matter": "^4.0.3",
    "ip-address": "10.3.1",
    "is-valid-domain": "^0.1.6",
    "micromark": "4.0.2",
    "micromark-extension-gfm": "3.0.0",
    "motion": "^12.23.12",
    "next": "16.3.0",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "9.0.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.4.296",
    "postcss": "^8.5.6",
    "posthog-js": "^1.360.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.55.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "10.4.1",
    "react-toastify": "^10.0.5",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "stripe": "^20.0.0",
    "tailwind-merge": "^3.3.1",
    "video.js": "^8.23.4",
    "zod": "^4.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@next/env": "16.3.0",
    "@next/eslint-plugin-next": "16.3.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "concurrently": "^9.2.1",
    "env-cmd": "^11.0.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "knip": "^5.82.1",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "typescript-eslint": "^8.52.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "sh -c 'pnpm typecheck'",
      "sh -c 'pnpm lint:fix --max-warnings=0 --no-warn-ignored'",
      "sh -c 'pnpm format:fix'"
    ],
    "*.{json,md,mdx,css,scss,html,yml,yaml}": [
      "sh -c 'pnpm format:fix'"
    ]
  }
}
