{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/modules/advanced-analytics/index.ts",
    "src/modules/custom-domains/index.ts",
    "src/modules/user-groups/index.ts",
    "tests/e2e/helpers/run-document-processing-job.ts"
  ],
  "project": [
    "src/**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}",
    "scripts/**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}",
    "tests/**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}"
  ],
  "ignore": ["docs-site/**"],
  "ignoreIssues": {
    "src/types/generated/**": ["exports", "types"]
  },
  "ignoreBinaries": ["supabase", "stripe"],
  "ignoreDependencies": [
    "tailwindcss",
    "tw-animate-css",
    "micromark",
    "micromark-extension-gfm"
  ]
}
